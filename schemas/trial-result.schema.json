{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trial-result.schema.json",
  "title": "TrialResult",
  "description": "One trial's immutable record. The reproducibility block is required in full: an experiment cannot be reproduced from model names alone, and a results table nobody can reproduce is not a result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "env", "finding_id", "arm", "n", "started_at", "completed_at",
               "verdict", "usage", "scoring_valid",
               "input_bundle_hash", "repository_commit", "runtime_image_id",
               "model", "model_version", "moa_preset", "moa_fanout",
               "hermes_version", "scanner_versions"],
  "properties": {
    "run_id":       { "type": "string", "minLength": 1 },
    "env":          { "type": "string", "minLength": 1 },
    "finding_id":   { "type": "string", "pattern": "^FIND-[0-9]{3,}$" },
    "arm":          { "enum": ["A", "B"] },
    "n":            { "type": "integer", "minimum": 1 },
    "started_at":   { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "verdict":      { "$ref": "review-verdict.schema.json" },
    "usage": {
      "description": "The ENGINEER's usage row, carried verbatim. Cost per trial is the number that decides whether the matrix can be re-run.",
      "type": "object"
    },
    "scoring_valid": {
      "description": "False when the arm B bundle carried telemetry that was not populated. Such a trial is excluded from the matrix rather than counted as a null result — see collector.py.",
      "type": "boolean"
    },
    "input_bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repository_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "runtime_image_id":  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "model":             { "type": "string", "minLength": 1 },
    "model_version":     { "type": "string", "minLength": 1 },
    "moa_preset":        { "type": "string", "minLength": 1 },
    "moa_fanout":        { "type": "string", "minLength": 1 },
    "hermes_version":    { "type": "string", "minLength": 1 },
    "scanner_versions": {
      "description": "Tool build identities. A finding is a function of the scanner that produced it; 'prowler' without a version does not identify one.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
