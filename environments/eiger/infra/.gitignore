# Local Terraform state and working directories — never commit these.
# .terraform.lock.hcl IS committed deliberately (Hashicorp's recommended
# practice) so provider versions are reproducible across applies.
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
